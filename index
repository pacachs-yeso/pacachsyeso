<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#064e3b">
  <meta name="description" content="Pacac High School YES-O, Youth for Environment in Schools Organization, School Year 2026-2027.">
  <title>Pacac High School YES-O | S.Y. 2026-2027</title>

  <style>
    /* =========================================================
       PACAC HIGH SCHOOL YES-O
       SCHOOL YEAR 2026-2027
       Single-file institutional website
       ========================================================= */

    :root {
      --forest: #064e3b;
      --forest-dark: #022c22;
      --emerald: #059669;
      --emerald-2: #10b981;
      --mint: #d1fae5;
      --mint-soft: #ecfdf5;
      --white: #ffffff;
      --charcoal: #17211d;
      --muted: #64756d;
      --border: rgba(255, 255, 255, 0.18);
      --light-border: rgba(6, 78, 59, 0.10);
      --shadow: 0 18px 50px rgba(2, 44, 34, 0.13);
      --radius-lg: 24px;
      --radius-md: 18px;
      --radius-sm: 13px;
      --container: 1160px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 92px;
    }

    body {
      font-family: Poppins, Gotham, Inter, Arial, sans-serif;
      color: var(--charcoal);
      background: #f4faf7;
      line-height: 1.6;
      overflow-x: hidden;
    }

    body.menu-open {
      overflow: hidden;
    }

    img {
      display: block;
      width: 100%;
      max-width: 100%;
    }

    button,
    a {
      font: inherit;
    }

    button {
      border: 0;
      cursor: pointer;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(calc(100% - 28px), var(--container));
      margin-inline: auto;
    }

    .section {
      position: relative;
      padding: 72px 0;
      overflow: hidden;
    }

    .section-label {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      margin-bottom: 10px;
      padding: 6px 11px;
      border: 1px solid rgba(5, 150, 105, 0.18);
      border-radius: 999px;
      background: rgba(236, 253, 245, 0.72);
      color: var(--emerald);
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .section-title {
      max-width: 720px;
      font-size: clamp(1.65rem, 5vw, 2.65rem);
      line-height: 1.15;
      font-weight: 650;
      letter-spacing: -0.035em;
    }

    .section-description {
      max-width: 700px;
      margin-top: 13px;
      color: var(--muted);
      font-size: 0.94rem;
    }

    .section-heading {
      margin-bottom: 30px;
    }

    /* =========================================================
       NAVIGATION
       ========================================================= */

    .site-header {
      position: fixed;
      z-index: 1000;
      top: 10px;
      left: 0;
      width: 100%;
      pointer-events: none;
    }

    .nav-shell {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 66px;
      padding: 8px 9px 8px 12px;
      border: 1px solid rgba(255, 255, 255, 0.32);
      border-radius: 21px;
      background: rgba(4, 54, 40, 0.78);
      backdrop-filter: blur(22px) saturate(150%);
      -webkit-backdrop-filter: blur(22px) saturate(150%);
      box-shadow: 0 12px 38px rgba(2, 44, 34, 0.22);
      pointer-events: auto;
    }

    .brand {
      display: flex;
      align-items: center;
      min-width: 0;
      gap: 9px;
      color: white;
    }

    .brand-logo {
      flex: 0 0 43px;
      width: 43px;
      height: 43px;
      object-fit: contain;
      border-radius: 12px;
    }

    .brand-text {
      min-width: 0;
      line-height: 1.15;
    }

    .brand-title {
      display: block;
      max-width: 225px;
      overflow: hidden;
      color: white;
      font-size: 0.72rem;
      font-weight: 650;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .brand-subtitle {
      display: block;
      margin-top: 3px;
      color: rgba(255,255,255,0.66);
      font-size: 0.62rem;
      white-space: nowrap;
    }

    .nav-toggle {
      display: grid;
      place-items: center;
      width: 43px;
      height: 43px;
      flex: 0 0 43px;
      border: 1px solid rgba(255,255,255,0.16);
      border-radius: 13px;
      background: rgba(255,255,255,0.10);
      color: white;
    }

    .nav-toggle span,
    .nav-toggle span::before,
    .nav-toggle span::after {
      display: block;
      width: 18px;
      height: 2px;
      border-radius: 999px;
      background: currentColor;
      transition: transform .22s ease;
    }

    .nav-toggle span {
      position: relative;
    }

    .nav-toggle span::before,
    .nav-toggle span::after {
      position: absolute;
      content: "";
    }

    .nav-toggle span::before {
      top: -6px;
    }

    .nav-toggle span::after {
      top: 6px;
    }

    .nav-toggle.active span {
      background: transparent;
    }

    .nav-toggle.active span::before {
      transform: translateY(6px) rotate(45deg);
    }

    .nav-toggle.active span::after {
      transform: translateY(-6px) rotate(-45deg);
    }

    .nav-menu {
      position: fixed;
      top: 84px;
      left: 14px;
      right: 14px;
      padding: 9px;
      border: 1px solid rgba(255,255,255,0.25);
      border-radius: 20px;
      background: rgba(3, 49, 37, 0.94);
      backdrop-filter: blur(22px);
      -webkit-backdrop-filter: blur(22px);
      box-shadow: var(--shadow);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px) scale(.98);
      transition: .22s ease;
    }

    .nav-menu.open {
      opacity: 1;
      visibility: visible;
      transform: translateY(0) scale(1);
    }

    .nav-link {
      display: block;
      padding: 12px 13px;
      border-radius: 12px;
      color: rgba(255,255,255,0.75);
      font-size: 0.82rem;
      transition: .2s ease;
    }

    .nav-link:hover,
    .nav-link.active {
      background: rgba(16,185,129,0.17);
      color: white;
    }

    /* =========================================================
       HOME
       ========================================================= */

    .hero {
      min-height: 100svh;
      display: flex;
      align-items: center;
      padding-top: 108px;
      padding-bottom: 54px;
      color: white;
      background:
        radial-gradient(circle at 90% 15%, rgba(16,185,129,0.26), transparent 32%),
        radial-gradient(circle at 0% 90%, rgba(52,211,153,0.13), transparent 30%),
        linear-gradient(145deg, #022c22 0%, #064e3b 50%, #047857 100%);
    }

    .hero-content {
      display: grid;
      gap: 28px;
    }

    .hero-copy {
      max-width: 680px;
    }

    .hero-kicker {
      display: inline-flex;
      margin-bottom: 15px;
      padding: 6px 11px;
      border: 1px solid rgba(255,255,255,0.18);
      border-radius: 999px;
      background: rgba(255,255,255,0.08);
      color: rgba(255,255,255,0.82);
      font-size: 0.72rem;
      letter-spacing: .06em;
      text-transform: uppercase;
    }

    .hero-title {
      max-width: 620px;
      font-size: clamp(2.15rem, 10vw, 4.4rem);
      line-height: 1.02;
      font-weight: 650;
      letter-spacing: -0.055em;
    }

    .hero-description {
      max-width: 590px;
      margin-top: 15px;
      color: rgba(255,255,255,0.76);
      font-size: 0.95rem;
    }

    .hero-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 19px;
    }

    .hero-meta span {
      padding: 7px 10px;
      border: 1px solid rgba(255,255,255,0.14);
      border-radius: 999px;
      background: rgba(255,255,255,0.07);
      color: rgba(255,255,255,0.85);
      font-size: 0.72rem;
    }

    .hero-image-wrap {
      width: 100%;
      max-width: 760px;
      padding: 6px;
      border: 1px solid rgba(255,255,255,0.18);
      border-radius: 23px;
      background: rgba(255,255,255,0.08);
      box-shadow: 0 24px 70px rgba(0,0,0,0.18);
    }

    .hero-image {
      aspect-ratio: 16 / 9;
      overflow: hidden;
      border-radius: 18px;
    }

    .hero-image img {
      height: 100%;
      object-fit: cover;
    }

    /* =========================================================
       ABOUT
       ========================================================= */

    .about {
      background:
        radial-gradient(circle at 15% 15%, rgba(16,185,129,0.14), transparent 28%),
        linear-gradient(135deg, #ecfdf5 0%, #ffffff 50%, #dff8eb 100%);
    }

    .about-grid {
      display: grid;
      gap: 28px;
    }

    .about-photo {
      padding: 6px;
      border: 1px solid rgba(5,150,105,0.14);
      border-radius: var(--radius-lg);
      background: rgba(255,255,255,0.56);
      box-shadow: var(--shadow);
    }

    .about-photo-inner {
      aspect-ratio: 4 / 3;
      overflow: hidden;
      border-radius: 18px;
    }

    .about-photo img {
      height: 100%;
      object-fit: cover;
    }

    .about-copy {
      padding: 4px 0;
    }

    .about-copy h3 {
      margin-bottom: 11px;
      font-size: 1.45rem;
      font-weight: 650;
    }

    .about-copy p {
      color: var(--muted);
      font-size: 0.91rem;
    }

    .about-points {
      display: grid;
      gap: 9px;
      margin-top: 19px;
    }

    .about-point {
      display: flex;
      gap: 10px;
      align-items: flex-start;
      padding: 12px;
      border: 1px solid var(--light-border);
      border-radius: 14px;
      background: rgba(255,255,255,0.62);
    }

    .point-icon {
      display: grid;
      place-items: center;
      width: 30px;
      height: 30px;
      flex: 0 0 30px;
      border-radius: 9px;
      background: linear-gradient(135deg, var(--forest), var(--emerald));
      color: white;
      font-size: .78rem;
    }

    .about-point strong {
      display: block;
      font-size: .81rem;
      font-weight: 650;
    }

    .about-point span {
      display: block;
      margin-top: 1px;
      color: var(--muted);
      font-size: .76rem;
    }

    /* =========================================================
       LEADERSHIP
       ========================================================= */

    .leadership {
      color: white;
      background:
        radial-gradient(circle at 85% 20%, rgba(52,211,153,0.15), transparent 30%),
        linear-gradient(145deg, #032c22, #064e3b 54%, #065f46);
    }

    .leadership .section-label {
      border-color: rgba(255,255,255,0.15);
      background: rgba(255,255,255,0.08);
      color: #a7f3d0;
    }

    .leadership .section-description {
      color: rgba(255,255,255,0.67);
    }

    .leadership-block {
      margin-top: 28px;
    }

    .leadership-block-title {
      margin-bottom: 13px;
      color: rgba(255,255,255,0.86);
      font-size: .78rem;
      font-weight: 600;
      letter-spacing: .06em;
      text-transform: uppercase;
    }

    .featured-leaders {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .leader-card {
      min-width: 0;
      padding: 10px;
      border: 1px solid rgba(255,255,255,0.13);
      border-radius: var(--radius-md);
      background: rgba(255,255,255,0.075);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
    }

    .leader-photo {
      width: 100%;
      aspect-ratio: 1 / 1;
      overflow: hidden;
      border-radius: 14px;
      background: linear-gradient(135deg, #d1fae5, #6ee7b7);
    }

    .leader-photo img {
      height: 100%;
      object-fit: cover;
    }

    .leader-name {
      margin-top: 10px;
      font-size: .79rem;
      font-weight: 650;
      color: white;
    }

    .leader-position {
      margin-top: 2px;
      color: rgba(255,255,255,0.58);
      font-size: .7rem;
    }

    .officer-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .officer-card {
      min-width: 0;
      padding: 8px;
      border: 1px solid rgba(255,255,255,0.11);
      border-radius: 16px;
      background: rgba(255,255,255,0.055);
      transition: transform .22s ease, background .22s ease;
    }

    .officer-card:hover {
      transform: translateY(-3px);
      background: rgba(255,255,255,0.09);
    }

    .officer-photo {
      width: 100%;
      aspect-ratio: 1 / 1;
      overflow: hidden;
      border-radius: 12px;
      background: linear-gradient(135deg, #a7f3d0, #10b981);
    }

    .officer-photo img {
      height: 100%;
      object-fit: cover;
    }

    .officer-name {
      margin-top: 8px;
      color: white;
      font-size: .73rem;
      font-weight: 650;
      line-height: 1.3;
    }

    .officer-position {
      margin-top: 2px;
      color: rgba(255,255,255,0.53);
      font-size: .65rem;
      line-height: 1.35;
    }

    /* =========================================================
       GALLERY
       ========================================================= */

    .gallery {
      background:
        radial-gradient(circle at 90% 10%, rgba(5,150,105,0.13), transparent 30%),
        linear-gradient(135deg, #ffffff, #ecfdf5 50%, #dff8eb);
    }

    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .gallery-card {
      padding: 7px;
      border: 1px solid rgba(6,78,59,0.09);
      border-radius: 16px;
      background: rgba(255,255,255,0.68);
      box-shadow: 0 10px 30px rgba(6,78,59,0.07);
      cursor: pointer;
      transition: transform .22s ease, box-shadow .22s ease;
    }

    .gallery-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 16px 38px rgba(6,78,59,0.12);
    }

    .gallery-image {
      aspect-ratio: 4 / 3;
      overflow: hidden;
      border-radius: 11px;
      background: linear-gradient(135deg, #d1fae5, #a7f3d0);
    }

    .gallery-image img {
      height: 100%;
      object-fit: cover;
      transition: transform .3s ease;
    }

    .gallery-card:hover img {
      transform: scale(1.035);
    }

    .gallery-title {
      padding: 9px 3px 3px;
      color: var(--forest);
      font-size: .75rem;
      font-weight: 650;
    }

    /* =========================================================
       ECOPEDIA
       ========================================================= */

    .ecopedia {
      color: white;
      background:
        radial-gradient(circle at 10% 10%, rgba(52,211,153,0.15), transparent 28%),
        radial-gradient(circle at 95% 90%, rgba(16,185,129,0.12), transparent 28%),
        linear-gradient(145deg, #022c22 0%, #064e3b 52%, #065f46 100%);
    }

    .ecopedia .section-label {
      color: #a7f3d0;
      border-color: rgba(255,255,255,0.14);
      background: rgba(255,255,255,0.07);
    }

    .ecopedia .section-description {
      color: rgba(255,255,255,0.67);
    }

    .month-selector {
      display: flex;
      gap: 7px;
      padding-bottom: 5px;
      margin: 26px 0 20px;
      overflow-x: auto;
      scrollbar-width: thin;
    }

    .month-btn {
      flex: 0 0 auto;
      padding: 9px 12px;
      border: 1px solid rgba(255,255,255,0.13);
      border-radius: 12px;
      background: rgba(255,255,255,0.065);
      color: rgba(255,255,255,0.68);
      font-size: .73rem;
      font-weight: 600;
      transition: .2s ease;
    }

    .month-btn.active,
    .month-btn:hover {
      background: linear-gradient(135deg, var(--emerald-2), #34d399);
      color: #022c22;
      border-color: transparent;
    }

    .month-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 14px;
      margin-bottom: 15px;
    }

    .month-name {
      font-size: 1.15rem;
      font-weight: 650;
    }

    .month-theme {
      color: #a7f3d0;
      font-size: .72rem;
      text-align: right;
    }

    .ecopedia-grid {
      display: grid;
      gap: 11px;
    }

    .eco-card {
      padding: 8px;
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 17px;
      background: rgba(255,255,255,0.065);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      animation: cardIn .28s ease both;
    }

    .eco-image {
      aspect-ratio: 16 / 9;
      overflow: hidden;
      border-radius: 12px;
      background: linear-gradient(135deg, #a7f3d0, #10b981);
    }

    .eco-image img {
      height: 100%;
      object-fit: cover;
    }

    .eco-content {
      padding: 10px 3px 4px;
    }

    .eco-content h3 {
      color: white;
      font-size: .86rem;
      font-weight: 650;
    }

    .eco-content p {
      margin-top: 4px;
      color: rgba(255,255,255,0.62);
      font-size: .73rem;
      line-height: 1.55;
    }

    @keyframes cardIn {
      from {
        opacity: 0;
        transform: translateY(7px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* =========================================================
       SPONSORS
       ========================================================= */

    .sponsors {
      background:
        radial-gradient(circle at 15% 20%, rgba(16,185,129,0.10), transparent 30%),
        linear-gradient(135deg, #f0fdf4, #ffffff 55%, #dcfce7);
    }

    .sponsor-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 9px;
    }

    .sponsor-card {
      min-height: 68px;
      display: grid;
      place-items: center;
      padding: 12px;
      border: 1px solid rgba(6,78,59,0.09);
      border-radius: 15px;
      background: linear-gradient(145deg, rgba(255,255,255,.86), rgba(209,250,229,.50));
      color: var(--forest);
      text-align: center;
      font-size: .77rem;
      font-weight: 650;
      transition: .2s ease;
    }

    .sponsor-card:hover {
      transform: translateY(-2px);
      border-color: rgba(5,150,105,.24);
      box-shadow: 0 12px 30px rgba(6,78,59,.09);
    }

    /* =========================================================
       BUDGET
       ========================================================= */

    .budget {
      color: white;
      background:
        radial-gradient(circle at 90% 10%, rgba(52,211,153,0.15), transparent 28%),
        linear-gradient(145deg, #022c22, #064e3b 56%, #065f46);
    }

    .budget .section-label {
      color: #a7f3d0;
      border-color: rgba(255,255,255,0.14);
      background: rgba(255,255,255,0.07);
    }

    .budget .section-description {
      color: rgba(255,255,255,0.65);
    }

    .financial-summary {
      display: grid;
      grid-template-columns: 1fr;
      gap: 9px;
      margin: 26px 0;
    }

    .finance-card {
      padding: 16px;
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 17px;
      background: rgba(255,255,255,0.065);
      backdrop-filter: blur(13px);
      -webkit-backdrop-filter: blur(13px);
    }

    .finance-label {
      color: rgba(255,255,255,0.58);
      font-size: .7rem;
    }

    .finance-value {
      margin-top: 4px;
      color: white;
      font-size: 1.35rem;
      line-height: 1.2;
      font-weight: 650;
    }

    .budget-table-wrap {
      overflow-x: auto;
      border: 1px solid rgba(255,255,255,0.11);
      border-radius: 17px;
      background: rgba(255,255,255,0.045);
    }

    .budget-table {
      width: 100%;
      min-width: 650px;
      border-collapse: collapse;
    }

    .budget-table th,
    .budget-table td {
      padding: 12px 13px;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      text-align: left;
      font-size: .72rem;
    }

    .budget-table th {
      color: #a7f3d0;
      font-weight: 600;
      background: rgba(0,0,0,0.10);
    }

    .budget-table td {
      color: rgba(255,255,255,0.76);
    }

    .budget-table td:nth-child(n+2) {
      text-align: right;
    }

    .budget-table tr:last-child td {
      border-bottom: 0;
    }

    /* =========================================================
       FOOTER
       ========================================================= */

    footer {
      padding: 42px 0 30px;
      color: rgba(255,255,255,0.72);
      background:
        radial-gradient(circle at 80% 20%, rgba(16,185,129,0.12), transparent 30%),
        #021f18;
    }

    .footer-inner {
      display: grid;
      gap: 20px;
    }

    .footer-brand {
      display: flex;
      align-items: center;
      gap: 11px;
    }

    .footer-logo {
      width: 50px;
      height: 50px;
      object-fit: contain;
      border-radius: 13px;
    }

    .footer-title {
      color: white;
      font-size: .84rem;
      font-weight: 650;
    }

    .footer-subtitle {
      margin-top: 2px;
      color: rgba(255,255,255,0.52);
      font-size: .68rem;
    }

    .footer-statement {
      max-width: 550px;
      color: rgba(255,255,255,0.57);
      font-size: .76rem;
    }

    .footer-bottom {
      padding-top: 18px;
      border-top: 1px solid rgba(255,255,255,0.08);
      color: rgba(255,255,255,0.4);
      font-size: .65rem;
    }

    /* =========================================================
       LIGHTBOX
       ========================================================= */

    .lightbox {
      position: fixed;
      z-index: 2000;
      inset: 0;
      display: grid;
      place-items: center;
      padding: 20px;
      background: rgba(1, 20, 15, 0.88);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      opacity: 0;
      visibility: hidden;
      transition: .22s ease;
    }

    .lightbox.open {
      opacity: 1;
      visibility: visible;
    }

    .lightbox-content {
      width: min(100%, 850px);
      position: relative;
      padding: 7px;
      border: 1px solid rgba(255,255,255,0.17);
      border-radius: 19px;
      background: rgba(255,255,255,0.08);
      transform: scale(.96);
      transition: .22s ease;
    }

    .lightbox.open .lightbox-content {
      transform: scale(1);
    }

    .lightbox-image {
      max-height: 72svh;
      overflow: hidden;
      border-radius: 13px;
    }

    .lightbox-image img {
      width: 100%;
      max-height: 72svh;
      object-fit: contain;
    }

    .lightbox-caption {
      padding: 10px 5px 3px;
      color: white;
      font-size: .8rem;
      font-weight: 600;
    }

    .lightbox-close {
      position: absolute;
      top: -11px;
      right: -7px;
      z-index: 2;
      width: 36px;
      height: 36px;
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 50%;
      background: #064e3b;
      color: white;
      font-size: 1rem;
    }

    /* =========================================================
       SCROLL REVEAL
       ========================================================= */

    .reveal {
      opacity: 0;
      transform: translateY(16px);
      transition: opacity .55s ease, transform .55s ease;
    }

    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

