      },


      "September 2026": {
        theme: "Native Flora of the Philippines",
        topics: [

          {
            title: "Kamagong",
            image: "EW5.png",
            description:
              "Biodiversity refers to the variety of living organisms, their genes, and ecosystems. Healthy biodiversity supports balanced ecosystems."
          }

        ]
      }

    };


    /* =========================================================
       ECOPEDIA RENDERING
       ========================================================= */

    const monthSelector = document.getElementById("monthSelector");
    const ecopediaContent = document.getElementById("ecopediaContent");

    let activeMonth = Object.keys(ecopediaData)[0];

    function renderMonthButtons() {

      monthSelector.innerHTML = "";

      Object.keys(ecopediaData).forEach(month => {

        const button = document.createElement("button");

        button.type = "button";
        button.className = "month-btn";
        button.textContent = month.replace(" 2026", "").replace(" 2027", "");

        button.setAttribute("role", "tab");
        button.setAttribute("aria-selected", String(month === activeMonth));

        if (month === activeMonth) {
          button.classList.add("active");
        }

        button.addEventListener("click", () => {
          activeMonth = month;
          renderMonthButtons();
          renderEcopedia();
        });

        monthSelector.appendChild(button);

      });
    }


    function renderEcopedia() {

      const month = ecopediaData[activeMonth];

      if (!month) return;

      ecopediaContent.innerHTML = `
        <div class="month-header">
          <div>
            <div class="month-name">${activeMonth}</div>
          </div>
          <div class="month-theme">${month.theme}</div>
        </div>

        <div class="ecopedia-grid">
          ${month.topics.map((topic, index) => `
            <article class="eco-card" style="animation-delay:${index * 45}ms">

              <div class="eco-image">
                <img
                  src="${topic.image}"
                  alt="${topic.title}"
                  loading="lazy"
                >
              </div>

              <div class="eco-content">
                <h3>${topic.title}</h3>
                <p>${topic.description}</p>
              </div>

            </article>
          `).join("")}
        </div>
      `;
    }

    renderMonthButtons();
    renderEcopedia();


    /* =========================================================
       BUDGET DATA
       EDIT AMOUNTS HERE
       ========================================================= */

    const budgetData = [

      {
        month: "August 2026",
        funds: 1300,
        expenses: 493
      },

      {
        month: "September 2026",
        funds: 0,
        expenses: 0
      },

      {
        month: "October 2026",
        funds: 0,
        expenses: 0
      },

      {
        month: "November 2026",
        funds: 0,
        expenses: 0
      },

      {
        month: "December 2026",
        funds: 0,
        expenses: 0
      },

      {
        month: "January 2027",
        funds: 0,
        expenses: 0
      },

      {
        month: "February 2027",
        funds: 0,
        expenses: 0
      },

      {
        month: "March 2027",
        funds: 0,
        expenses: 0
      }

    ];


    /* =========================================================
       BUDGET CALCULATIONS
       ========================================================= */

    const pesoFormatter = new Intl.NumberFormat("en-PH", {
      style: "currency",
      currency: "PHP",
      minimumFractionDigits: 2
    });

    function calculateBudget() {

      let totalFunds = 0;
      let totalExpenses = 0;
      let runningBalance = 0;

      const budgetBody = document.getElementById("budgetBody");

      budgetBody.innerHTML = "";

      budgetData.forEach(row => {

        totalFunds += Number(row.funds) || 0;
        totalExpenses += Number(row.expenses) || 0;

        runningBalance += (Number(row.funds) || 0);
        runningBalance -= (Number(row.expenses) || 0);

        const tr = document.createElement("tr");

        tr.innerHTML = `
          <td>${row.month}</td>
          <td>${pesoFormatter.format(row.funds)}</td>
          <td>${pesoFormatter.format(row.expenses)}</td>
          <td>${pesoFormatter.format(runningBalance)}</td>
        `;

        budgetBody.appendChild(tr);

      });

      const remaining = totalFunds - totalExpenses;

      document.getElementById("totalFund").textContent =
        pesoFormatter.format(totalFunds);

      document.getElementById("totalExpenses").textContent =
        pesoFormatter.format(totalExpenses);

      document.getElementById("remainingFunds").textContent =
        pesoFormatter.format(remaining);
    }

    calculateBudget();


    /* =========================================================
       GALLERY LIGHTBOX
       ========================================================= */

    const lightbox = document.getElementById("lightbox");
    const lightboxImg = document.getElementById("lightboxImg");
    const lightboxCaption = document.getElementById("lightboxCaption");
    const lightboxClose = document.getElementById("lightboxClose");

    let lastFocusedGalleryItem = null;

    function openLightbox(card) {

      const image = card.dataset.image;
      const title = card.dataset.title;

      if (!image) return;

      lastFocusedGalleryItem = card;

      lightboxImg.src = image;
      lightboxImg.alt = title;
      lightboxCaption.textContent = title;

      lightbox.classList.add("open");
      document.body.classList.add("menu-open");

      lightboxClose.focus();
    }


    function closeLightbox() {

      lightbox.classList.remove("open");
      document.body.classList.remove("menu-open");

      lightboxImg.src = "";
      lightboxImg.alt = "";

      if (lastFocusedGalleryItem) {
        lastFocusedGalleryItem.focus();
      }
    }


    document.querySelectorAll(".gallery-card").forEach(card => {

      card.addEventListener("click", () => {
        openLightbox(card);
      });

      card.addEventListener("keydown", event => {

        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          openLightbox(card);
        }

      });

    });


    lightboxClose.addEventListener("click", closeLightbox);


    lightbox.addEventListener("click", event => {

      if (event.target === lightbox) {
        closeLightbox();
      }

    });


    document.addEventListener("keydown", event => {

      if (event.key === "Escape") {

        if (lightbox.classList.contains("open")) {
          closeLightbox();
        } else if (navMenu.classList.contains("open")) {
          closeMenu();
        }

      }

    });


    /* =========================================================
       CLOSE MOBILE MENU WHEN RESIZING TO DESKTOP
       ========================================================= */

    window.addEventListener("resize", () => {

      if (window.innerWidth >= 800) {
        closeMenu();
      }

    });

  </script>

</body>
</html>
